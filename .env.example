# Copia este archivo a .env para desarrollo local (.env está en .gitignore).
# En Railway, pon estas mismas variables en el servicio → Variables.

# Webhook de Discord (Server Settings -> Integrations -> Webhooks -> Copy URL).
# Avisa al iniciar y al terminar cada trabajo, con el .luau resultante adjunto.
# Vacío = sin notificaciones.
DISCORD_WEBHOOK_URL=

# Trabajos que corren a la vez (cada uno es una VM de Luau); el resto espera en cola.
MAX_CONCURRENT_JOBS=1

# Tope duro por trabajo, en segundos (mata el proceso y sus hijos).
HARD_KILL_SECONDS=1200

# Primera línea que se agrega a cada script deofuscado ("-- <texto>"). El crédito del
# motor original queda debajo. Vacío = sin marca.
WATERMARK=deob by josz

# Sitios extra desde los que se puede descargar un script por enlace (además de GitHub, Gist, GitLab,
# Pastebin y los archivos de Discord). Lista separada por comas, solo el dominio.
FETCH_ALLOWED_HOSTS=
